# =============================================================================
# AgenticSystem — environment template
# Copy to .env:  cp .env.example .env
#
# LOCAL setup  → set OPENAI_API_KEY + TAVILY_API_KEY (leave POSTGRES_HOST unset)
# DOCKER setup → add POSTGRES_PASSWORD (compose injects POSTGRES_HOST for you)
# =============================================================================

# --- Required (both modes) ---
OPENAI_API_KEY="your-openai-api-key"
TAVILY_API_KEY="your-tavily-api-key"

# --- Optional: observability ---
LANGFUSE_SECRET_KEY="sk-your-key"
LANGFUSE_PUBLIC_KEY="pk-your-key"
LANGFUSE_HOST="http://localhost:3000"
LANGSMITH_API_KEY=""

# --- Local only: MCP via stdio subprocess ---
MCP_SERVER_PATH="servers/pasta_mcp/pasta_server.py"

# --- Local only: optional override (skip stdio, connect to HTTP MCP directly) ---
# MCP_SERVER_URL="http://localhost:8001/mcp"

# --- Docker only: PostgreSQL password (compose sets host/user/db) ---
POSTGRES_PASSWORD="agentic"

# --- Do not set unless you know why (compose overrides in Docker) ---
# POSTGRES_HOST="postgres"
# POSTGRES_PORT="5432"
# POSTGRES_USER="agentic"
# POSTGRES_DB="agentic"
# MCP_SERVER_NAME="pasta-expert"
# MCP_PUBLIC_URL="http://mcp-server:8001/mcp"
